**/build/
**/out/
**/.next/
**/.turbo/
**/.vite/
**/coverage/
**/playwright-report/
**/test-results/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
console.log*

# Local QA and evidence
output/
output/playwright/
**/playwright/.cache/
.phase2f-fixture-state.local.json

# Local databases and generated data
pgdata/
**/pgdata/
tmp/
**/tmp/
tmp-*
*.tmp.txt
xflow-test-output*.txt
supabase/.branches/
supabase/.temp/

# Local tool workspaces and smoke folders
.agents/
.codex-lander-smoke/
.playwright-cli/
.tmp-public-smoke/
.cursor/ownership.local.md
.worktrees/
