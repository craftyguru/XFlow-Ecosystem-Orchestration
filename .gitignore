# Stale root pnpm metadata; root orchestration is npm-owned.
/pnpm-lock.yaml

# Env and secrets
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.jks

# Build and cache output
dist/
build/
out/
.next/
.turbo/
.vite/
coverage/
playwright-report/
test-results/
